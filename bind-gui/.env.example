# Security: Generate a strong secret using: openssl rand -base64 32
AUTH_SECRET=

# Admin credentials for NextAuth.js authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Path to BIND configuration directory (usually /app/bind/config)
CONFIG_DIR=/app/bind/config
# URL where the NextAuth.js authentication will be available (e.g., http://localhost:3001)
NEXTAUTH_URL=

# BIND9 container hostname for rndc and nsupdate connections
# BIND_RNDC_HOST=bind9
# BIND_DNS_HOST=bind9

# Path to the TSIG key file for nsupdate (RFC 2136) authentication
# TSIG_KEY_FILE=/etc/bind/bind-gui.key

# ── OIDC login (optional; e.g. Authentik, Keycloak, Authelia) ─────────
# Redirect URI to register in the provider: <NEXTAUTH_URL>/api/auth/callback/oidc
# Authentik issuer: https://auth.example.com/application/o/<app-slug>/
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_SCOPE=openid profile email
# Restrict access (comma-separated; if both empty, any authenticated user is allowed)
# OIDC_ALLOWED_GROUPS=dns-admins
# OIDC_ALLOWED_EMAILS=
# OIDC_GROUPS_CLAIM=groups
# Hide the username/password form when OIDC is configured
# OIDC_DISABLE_PASSWORD=true

# When BIND runs on another machine and the config dir is not mounted,
# list the zones the TSIG key may read (comma-separated). bind-gui reads
# them with AXFR, so the BIND zone needs `allow-transfer { key <key>; };`.
# BIND_ZONES=zone1.example.com
# BIND_DNS_PORT=53
