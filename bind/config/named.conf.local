// ── Local Zone Declarations ─────────────────────────────────────────
// This file is included by named.conf. You usually don't need to edit
// it manually — the Bind DNS GUI writes zone blocks here automatically
// when you create a zone through the web UI.
//
// Edit this file only if you are:
//   • Importing existing zones from another BIND server
//   • Declaring a zone before the GUI is configured
//
// To add a zone manually:
//   1. Add a `zone "name" { ... };` block below.
//   2. Include `allow-update { key "bind-gui-key"; };` if you want
//      the GUI to be able to edit its records.
//   3. Reload BIND without restarting the container:
//        docker compose exec bind-gui \
//          rndc -s bind9 -k /etc/bind/bind-gui.key reconfig
//
// For the zone file format, see the BIND docs:
//   https://bind9.readthedocs.io/en/latest/reference.html#zone-file

// ── Statistics Channel ──────────────────────────────────────────────
// Exposes BIND statistics as JSON on port 8953. The port is NOT
// published to the host — only containers on the same Docker network
// (bind-gui) can reach it. No authentication; the Docker network
// boundary is the security control.
statistics-channels {
    inet * port 8953 allow { any; };
};

// ── Zones (example.com) ─────────────────────────────────────────────
// zone1: dynamic updates allowed ONLY with TSIG "zone1-key" (used by bind-gui).
zone "zone1.example.com" {
    type master;
    file "/etc/bind/db.zone1.example.com";
    // Reading the zone (AXFR) is a transfer, not an update: update-policy
    // does not cover it, so it must be granted explicitly to the key.
    allow-transfer { key zone1-key; };
    update-policy {
        grant zone1-key zonesub ANY;
    };
};

// zone2: static, no dynamic updates (zone1-key has no rights here).
zone "zone2.example.com" {
    type master;
    file "/etc/bind/db.zone2.example.com";
    allow-update { none; };
    allow-transfer { none; };
};
