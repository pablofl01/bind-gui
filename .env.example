# ── Bind DNS GUI — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values before running:
#   docker compose up -d
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows)

# ── Required ─────────────────────────────────────────────────────────

# Secret key used to encrypt session cookies.
# Generate a strong random value:
#   openssl rand -base64 32
AUTH_SECRET=changeme-to-a-random-secret

# Admin account password.
# Choose something strong — this is the only gate to your DNS UI.
ADMIN_PASSWORD=changeme-to-something-strong

# ── Optional ─────────────────────────────────────────────────────────

# Admin username (default: admin)
ADMIN_USERNAME=admin

# Public URL of the GUI. Change if running behind a reverse proxy.
#   e.g. NEXTAUTH_URL=https://dns.example.com

# BIND9 container hostnames for rndc and nsupdate communication
# These are the Docker Compose service names inside the dns-net network.
# Only change if your BIND container has a different hostname.
# BIND_RNDC_HOST=bind9
# BIND_DNS_HOST=bind9

# Path to the TSIG key file for nsupdate authentication
# TSIG_KEY_FILE=/etc/bind/bind-gui.key
NEXTAUTH_URL=http://localhost:3001

# ── OIDC login (optional; e.g. Authentik, Keycloak, Authelia) ─────────
# Redirect URI to register in the provider: <NEXTAUTH_URL>/api/auth/callback/oidc
# Authentik issuer: https://auth.example.com/application/o/<app-slug>/
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_SCOPE=openid profile email
# Restrict access (comma-separated; if both empty, any authenticated user is allowed)
# OIDC_ALLOWED_GROUPS=dns-admins
# OIDC_ALLOWED_EMAILS=
# OIDC_GROUPS_CLAIM=groups
# Hide the username/password form when OIDC is configured
# OIDC_DISABLE_PASSWORD=true
